# backend/.env.example
PORT=5001
NODE_ENV=development

# Database connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/dailymart?retryWrites=true&w=majority

# JWT token signing secret
JWT_SECRET=your_cryptographically_secure_jwt_secret_key

# Gmail API OAuth2 Configuration (HTTPS over Port 443)
SMTP_EMAIL=your_email@gmail.com
GOOGLE_CLIENT_ID=your_google_oauth2_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth2_client_secret
GOOGLE_REFRESH_TOKEN=your_google_oauth2_refresh_token

# Cross-Reference URLs (Required for email redirect actions)
BACKEND_API_URL=http://localhost:5001
FRONTEND_URL=http://localhost:3000
