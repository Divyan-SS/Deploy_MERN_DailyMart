# backend/.env.example
PORT=5001
NODE_ENV=development

# Database connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/dailymart?retryWrites=true&w=majority

# JWT token signing secret
JWT_SECRET=your_cryptographically_secure_jwt_secret_key

# Nodemailer SMTP Mail Transport (e.g., Gmail)
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_gmail_16_character_app_password

# Cross-Reference URLs (Required for email redirect actions)
BACKEND_API_URL=http://localhost:5001
FRONTEND_URL=http://localhost:3000
