# backend/.env.example
PORT=5001
NODE_ENV=development

# Database connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/dailymart?retryWrites=true&w=majority

# JWT token signing secret
JWT_SECRET=your_cryptographically_secure_jwt_secret_key

# Email Delivery Service (Resend HTTPS API - port 443)
# Get your API key from https://resend.com
RESEND_API_KEY=re_123456789
SMTP_EMAIL=onboarding@resend.dev # or your verified custom domain email (e.g., no-reply@yourdomain.com)

# Cross-Reference URLs (Required for email redirect actions)
BACKEND_API_URL=http://localhost:5001
FRONTEND_URL=http://localhost:3000
